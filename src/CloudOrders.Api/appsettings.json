{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cloudorders;Username=cloudorders;Password=cloudorders_dev",
    "ServiceBus": ""
  },
  "Messaging": {
    "TopicName": "order-events",
    "SubscriptionName": "messaging-probe"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 5
  },
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Exporter": "None"
  },
  "AllowedHosts": "*"
}
